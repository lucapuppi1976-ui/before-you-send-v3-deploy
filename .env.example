# Before You Send: copy this file to .env and fill it in. Never commit .env.
# Variables already set in the environment (for example by NSSM or Render) win over this file.

# --- Claude (Anthropic): text and screenshot analysis -------------------------------
# Use a key from a dedicated BYS workspace that has a monthly spend limit.
ANTHROPIC_API_KEY=
BYS_MODEL=claude-sonnet-5-5
BYS_EFFORT=low
# BYS_MAX_TOKENS=16000
# BYS_AI_TIMEOUT_SECONDS=60
# BYS_AI_MAX_RETRIES=2

# --- Groq: voice-note transcription (leave the key empty to turn voice off) ---------
GROQ_API_KEY=
BYS_TRANSCRIBE_MODEL=whisper-large-v3-turbo
# BYS_TRANSCRIBE_TIMEOUT_SECONDS=60

# --- Access gate (on unless BYS_GATE_ENABLED=false) ---------------------------------
# BYS_GATE_SECRET is required: a random value of at least 32 characters. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# and put it on a line of its own (launch_windows.bat appends one for you):
# BYS_GATE_SECRET=
# Change the epoch (1, 2, 3...) to sign everyone out.
BYS_GATE_EPOCH=1
BYS_ACCESS_PAGE_URL=https://bb1studio.com/before-you-send/access/
# Optional shared tester code with unlimited use; per-user codes live in the database.
BYS_ACCESS_CODE=
# SQLite file with the access codes (relative paths start from the project folder).
BYS_DB_PATH=./data/bys.db
BYS_TRIAL_QUOTA=30
# Bearer token for POST /admin/codes from this machine (32+ characters; empty disables it).
BYS_ADMIN_TOKEN=
# BYS_ACCESS_COOKIE_DAYS=30
# BYS_ACCESS_COOKIE_NAME=bys_access

# --- Limits --------------------------------------------------------------------------
# BYS_MAX_IMAGE_MB=5
# BYS_MAX_AUDIO_MB=15
# BYS_RL_UNLOCK_PER_MINUTE=5
# BYS_RL_UNLOCK_PER_HOUR=30
# BYS_RL_AI_PER_MINUTE=10
# BYS_RL_AI_PER_DAY=200
# BYS_LOG_LEVEL=INFO
